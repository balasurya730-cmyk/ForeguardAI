# ---- Database ----
# SQLite for development. To migrate to MySQL, change to:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/forgeguard
DATABASE_URL=sqlite:///./forgeguard.db

# ---- Auth ----
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- MQTT ----
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=forgeguard

# ---- Mode ----
# DEMO enables the built-in sensor/AI simulator so the app runs with no hardware.
# LIVE expects real ESP32 (MQTT) and camera (AI pipeline) sources.
SYSTEM_MODE=DEMO

# ---- Uploads ----
UPLOADS_DIR=../uploads
